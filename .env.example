# Google Gemini API key — server-side only, used by src/lib/gemini.ts.
# Never hardcode, never log, read only from this env var.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3.5-flash — the
# stable default; move to gemini-3.8-flash later if reasoning quality needs it)
# GEMINI_MODEL=gemini-3.5-flash

# Supabase project URL and keys (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot used for designer handoff notes. Optional for the demo —
# if unset, handoff notes are logged to the console/DB instead of sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
